{
  "name": "techdesk",
  "private": true,
  "version": "0.0.0",
  "description": "TechDesk: one shop product, three desktop editions, plus web and mobile.",
  "author": {
    "name": "TechDesk",
    "email": "techdeskapp@gmail.com"
  },
  "workspaces": [
    "apps/desktop",
    "apps/mobile",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w techdesk",
    "build": "npm run build -w techdesk",
    "test": "npm run test --workspaces --if-present",
    "dist": "npm run dist -w techdesk",
    "electron:dev": "npm run electron:dev -w techdesk",
    "build:mobile": "npm run build -w @techdesk/mobile",
    "sync:android": "npm run sync -w @techdesk/mobile",
    "activation:generate": "node scripts/generate-activation-table.mjs",
    "build:web": "npm run build -w @techdesk/web && node scripts/build-monitor-web.mjs",
    "build:monitor-web": "node scripts/build-monitor-web.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
