{
  "name": "techdesk",
  "private": true,
  "version": "0.0.0",
  "description": "TechDesk: one shop product, three desktop editions, plus web and mobile.",
  "author": {
    "name": "Oluwaseun Joshua",
    "email": "seun85148@gmail.com"
  },
  "workspaces": [
    "apps/desktop",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @techdesk/desktop",
    "build": "npm run build -w @techdesk/desktop",
    "test": "npm run test --workspaces --if-present",
    "dist": "npm run dist -w @techdesk/desktop",
    "electron:dev": "npm run electron:dev -w @techdesk/desktop",
    "build:mobile": "npm run build -w @techdesk/mobile",
    "sync:android": "npm run sync -w @techdesk/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}
