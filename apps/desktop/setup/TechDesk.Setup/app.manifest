<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="TechDesk.Setup" />

  <!-- asInvoker, deliberately, and this is the single most important line in
       the project.

       TechDesk installs for the person running it: into their own
       %LOCALAPPDATA%, their own HKCU, their own desktop. It needs no
       administrator rights, so it must not ask for them. Asking would be
       worse than rude:

         1. A per-machine copy living beside a per-user copy is exactly what
            put two TechDesk shortcuts on the desktop and two entries in
            Add/Remove Programs, which 4.16.1 and 4.16.2 were spent undoing.
         2. electron-updater runs this installer unattended when the app
            quits. A UAC prompt there has nobody to answer it, so the update
            would hang or be refused and the shop would simply stop
            receiving updates.

       If this is ever changed to requireAdministrator, both of those come
       straight back. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- Per-monitor DPI: the installer draws animation, and on a scaled
       display a system-DPI-aware window gets bitmap-stretched and the
       motion looks soft and juddery. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
