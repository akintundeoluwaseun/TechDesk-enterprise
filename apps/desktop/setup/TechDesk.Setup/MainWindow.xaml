<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TechDesk.Setup.MainWindow"
        Title="TechDesk Setup"
        Height="582" Width="884"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ground}"
        FontFamily="{StaticResource BodyFace}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

  <!-- AllowsTransparency is deliberately left off. It would let the window
       have rounded corners of its own, but it also drops the window out of
       hardware composition, and everything interesting in here is moving
       vector art. Smooth motion is worth more than a rounded corner, and
       Windows 11 rounds the corners anyway. -->

  <Window.Resources>

    <!-- The window arriving. The content scales up very slightly from 97%
         while fading in, which reads as the panel settling into place rather
         than appearing from nowhere. -->
    <Storyboard x:Key="Enter">
      <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.34" />
      <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                       From="0.97" To="1" Duration="0:0:0.42"
                       EasingFunction="{StaticResource Glide}" />
      <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                       From="0.97" To="1" Duration="0:0:0.42"
                       EasingFunction="{StaticResource Glide}" />
    </Storyboard>

  </Window.Resources>

  <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="RootScale" />
    </Grid.RenderTransform>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="272" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ================= the rail ================= -->
    <Grid Grid.Column="0" Background="{StaticResource Rail}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Brand. The mark breathes: a slow scale and glow that never stops,
           so the window is never completely still even while it waits for a
           click. -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="30,34,0,0">
        <Grid Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform>
            <ScaleTransform x:Name="MarkScale" />
          </Grid.RenderTransform>
          <Ellipse Fill="{StaticResource Accent}" Opacity="0.22" />
          <Ellipse Margin="5" Stroke="{StaticResource Cyan}" StrokeThickness="1.6" Opacity="0.85" />
          <TextBlock Text="T" FontFamily="{StaticResource Face}" FontSize="19" FontWeight="Bold"
                     Foreground="{StaticResource Text}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX"
                                   From="1" To="1.07" Duration="0:0:2.4" AutoReverse="True"
                                   EasingFunction="{StaticResource Settle}" />
                  <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY"
                                   From="1" To="1.07" Duration="0:0:2.4" AutoReverse="True"
                                   EasingFunction="{StaticResource Settle}" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Grid.Triggers>
        </Grid>
        <StackPanel Margin="13,2,0,0" VerticalAlignment="Center">
          <TextBlock Text="TechDesk" FontFamily="{StaticResource Face}" FontSize="17"
                     FontWeight="SemiBold" Foreground="{StaticResource Text}" />
          <TextBlock x:Name="RailVersion" Style="{StaticResource Label}" Margin="0,1,0,0" />
        </StackPanel>
      </StackPanel>

      <!-- The four steps, with a pill that slides to whichever is current.
           The pill is one element that moves, rather than four that switch
           on and off: the movement is what tells you the installer went
           forward. -->
      <Grid Grid.Row="1" Margin="0,46,0,0" VerticalAlignment="Top">
        <Border x:Name="Pill" Width="3" Height="44" CornerRadius="2"
                Background="{StaticResource Accent}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,0,0,0">
          <Border.RenderTransform>
            <TranslateTransform x:Name="PillSlide" />
          </Border.RenderTransform>
        </Border>

        <StackPanel x:Name="Steps" Margin="42,0,22,0">
          <StackPanel Height="44" VerticalAlignment="Center" Tag="step">
            <TextBlock Text="01" Style="{StaticResource Label}" />
            <TextBlock Text="Welcome" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Height="44" VerticalAlignment="Center" Tag="step">
            <TextBlock Text="02" Style="{StaticResource Label}" />
            <TextBlock Text="Where it goes" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Height="44" VerticalAlignment="Center" Tag="step">
            <TextBlock Text="03" Style="{StaticResource Label}" />
            <TextBlock Text="Installing" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel Height="44" VerticalAlignment="Center" Tag="step">
            <TextBlock Text="04" Style="{StaticResource Label}" />
            <TextBlock Text="Ready" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <TextBlock Grid.Row="2" Style="{StaticResource Label}" Margin="30,0,30,26"
                 TextWrapping="Wrap" Text="The shop, on the computer at the counter." />
    </Grid>

    <!-- ================= the pages ================= -->
    <Grid Grid.Column="1" ClipToBounds="True">

      <Button x:Name="CloseButton" Style="{StaticResource Chrome}" Content="&#xE8BB;"
              HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10"
              Click="OnClose" />

      <!-- 01 Welcome -->
      <Grid x:Name="PageWelcome" Margin="46,0,46,0" Opacity="0">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="WelcomeSlide" />
        </Grid.RenderTransform>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Label}" Text="TECHDESK SETUP" />
          <TextBlock Style="{StaticResource Title}" Margin="0,12,0,0"
                     Text="Let's put TechDesk on this computer." />
          <TextBlock Style="{StaticResource Body}" Margin="0,14,0,0" MaxWidth="440"
                     Text="It installs for you alone, in your own user folder, so it needs no administrator password and will not disturb anyone else who uses this PC." />
          <StackPanel x:Name="WelcomePoints" Margin="0,26,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,34,0,0">
            <Button x:Name="InstallButton" Style="{StaticResource Primary}"
                    Content="Install TechDesk" Click="OnInstall" />
            <Button x:Name="ChooseButton" Style="{StaticResource Quiet}" Margin="12,0,0,0"
                    Content="Choose where" Click="OnChoose" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- 02 Where it goes -->
      <Grid x:Name="PageLocation" Margin="46,0,46,0" Opacity="0" Visibility="Collapsed">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="LocationSlide" />
        </Grid.RenderTransform>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Label}" Text="WHERE IT GOES" />
          <TextBlock Style="{StaticResource Title}" Margin="0,12,0,0" Text="This folder." />
          <TextBlock Style="{StaticResource Body}" Margin="0,14,0,0" MaxWidth="460"
                     Text="The default is inside your own user folder, which is why no administrator password is needed. If you have installed TechDesk here before, the new version replaces it." />
          <Border Margin="0,22,0,0" Padding="16,13" CornerRadius="9"
                  Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}"
                  BorderThickness="1" MaxWidth="470" HorizontalAlignment="Left">
            <TextBox x:Name="PathText" Style="{StaticResource PathEntry}" />
          </Border>
          <TextBlock x:Name="SpaceText" Style="{StaticResource Label}" Margin="2,10,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
            <Button x:Name="ConfirmButton" Style="{StaticResource Primary}"
                    Content="Install here" Click="OnInstall" />
            <Button Style="{StaticResource Quiet}" Margin="12,0,0,0"
                    Content="Use the default folder" Click="OnResetPath" />
            <Button Style="{StaticResource Quiet}" Margin="12,0,0,0"
                    Content="Back" Click="OnBack" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- 03 Installing -->
      <Grid x:Name="PageInstalling" Margin="46,0,46,0" Opacity="0" Visibility="Collapsed">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="InstallingSlide" />
        </Grid.RenderTransform>
        <StackPanel VerticalAlignment="Center">

          <!-- Ambient motion while the work happens. Three rings turning at
               different speeds and in opposite directions, with a core that
               pulses. This is the part an installer normally has nothing in:
               copying files takes a minute and a frozen window makes that
               minute feel broken. -->
          <Grid Width="132" Height="132" HorizontalAlignment="Left" Margin="0,0,0,4">
            <Ellipse Width="132" Height="132" Stroke="{StaticResource Stroke}" StrokeThickness="1" Opacity="0.65" />

            <Ellipse x:Name="RingOuter" Width="132" Height="132" StrokeThickness="2.4"
                     Stroke="{StaticResource Cyan}" StrokeDashArray="7 30" StrokeDashCap="Round"
                     RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <RotateTransform x:Name="RingOuterTurn" />
              </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="RingMiddle" Width="100" Height="100" StrokeThickness="2"
                     Stroke="{StaticResource Violet}" StrokeDashArray="3 14" StrokeDashCap="Round"
                     RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <RotateTransform x:Name="RingMiddleTurn" />
              </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="RingInner" Width="70" Height="70" StrokeThickness="1.6"
                     Stroke="{StaticResource Mint}" StrokeDashArray="2 9" StrokeDashCap="Round"
                     Opacity="0.8" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <RotateTransform x:Name="RingInnerTurn" />
              </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="Core" Width="26" Height="26" Fill="{StaticResource Accent}"
                     RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <ScaleTransform x:Name="CoreScale" />
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>

          <TextBlock Style="{StaticResource Label}" Text="INSTALLING" Margin="0,18,0,0" />
          <TextBlock x:Name="StageText" Style="{StaticResource Title}" FontSize="25" Margin="0,10,0,0"
                     Text="Getting ready" />

          <!-- The bar. Its width is animated to each new value rather than
               set, so it glides instead of stepping, and a highlight sweeps
               along it continuously so it reads as working even during a
               large file that takes a few seconds on its own. -->
          <Grid Margin="0,22,0,0" MaxWidth="470" HorizontalAlignment="Left" Width="470">
            <Border Height="7" CornerRadius="4" Background="#16233D"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1" />
            <Border x:Name="BarTrack" Height="7" CornerRadius="4" HorizontalAlignment="Left"
                    ClipToBounds="True" Width="0">
              <Grid>
                <Border Background="{StaticResource Accent}" CornerRadius="4" />
                <Border x:Name="Shimmer" Width="120" HorizontalAlignment="Left">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#00FFFFFF" Offset="0" />
                      <GradientStop Color="#59FFFFFF" Offset="0.5" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Border.RenderTransform>
                    <TranslateTransform x:Name="ShimmerSlide" />
                  </Border.RenderTransform>
                </Border>
              </Grid>
            </Border>
          </Grid>

          <Grid Margin="0,11,0,0" MaxWidth="470" HorizontalAlignment="Left" Width="470">
            <TextBlock x:Name="PercentText" Style="{StaticResource Label}" HorizontalAlignment="Left" />
            <TextBlock x:Name="FileText" Style="{StaticResource Label}" HorizontalAlignment="Right"
                       Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"
                       MaxWidth="330" />
          </Grid>
        </StackPanel>
      </Grid>

      <!-- 04 Ready -->
      <Grid x:Name="PageDone" Margin="46,0,46,0" Opacity="0" Visibility="Collapsed">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="DoneSlide" />
        </Grid.RenderTransform>
        <StackPanel VerticalAlignment="Center">

          <!-- The tick is drawn on rather than shown: a clip rectangle widens
               across it, which is the one reveal that cannot go wrong at any
               scale. The ring behind it expands and fades once, like a
               single beat. -->
          <Grid Width="104" Height="104" HorizontalAlignment="Left">
            <Ellipse x:Name="DonePulse" Width="104" Height="104" Stroke="{StaticResource Mint}"
                     StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <ScaleTransform x:Name="DonePulseScale" />
              </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="84" Height="84" Fill="#16233D" Stroke="{StaticResource Mint}"
                     StrokeThickness="1.6" Opacity="0.9" />
            <Path x:Name="Tick" Stroke="{StaticResource Mint}" StrokeThickness="5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M 30,53 L 44,66 L 73,37" Width="104" Height="104"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path.Clip>
                <RectangleGeometry x:Name="TickClip" Rect="0,0,0,104" />
              </Path.Clip>
            </Path>
          </Grid>

          <TextBlock Style="{StaticResource Label}" Text="READY" Margin="0,22,0,0" />
          <TextBlock Style="{StaticResource Title}" Margin="0,10,0,0" Text="TechDesk is on this computer." />
          <TextBlock x:Name="DoneWhere" Style="{StaticResource Body}" Margin="0,12,0,0" MaxWidth="460" />
          <TextBlock x:Name="DoneNotice" Style="{StaticResource Body}" Margin="0,12,0,0" MaxWidth="460"
                     Foreground="{StaticResource Violet}" Visibility="Collapsed" />
          <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
            <Button x:Name="StartButton" Style="{StaticResource Primary}"
                    Content="Start TechDesk" Click="OnStart" />
            <Button Style="{StaticResource Quiet}" Margin="12,0,0,0" Content="Close" Click="OnClose" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Something went wrong -->
      <Grid x:Name="PageTrouble" Margin="46,0,46,0" Opacity="0" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Label}" Text="DID NOT FINISH" />
          <TextBlock Style="{StaticResource Title}" Margin="0,12,0,0" Text="TechDesk was not installed." />
          <TextBlock x:Name="TroubleText" Style="{StaticResource Body}" Margin="0,14,0,0" MaxWidth="470" />
          <Border Margin="0,18,0,0" Padding="14,11" CornerRadius="9" MaxWidth="470"
                  HorizontalAlignment="Left" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <TextBlock x:Name="TroubleLog" Style="{StaticResource Label}" TextWrapping="Wrap" />
          </Border>
          <TextBlock Style="{StaticResource Body}" Margin="0,16,0,0" MaxWidth="470"
                     Text="Nothing on this PC was changed: if TechDesk was already installed, that copy is still there and still works." />
          <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
            <Button Style="{StaticResource Primary}" Content="Try again" Click="OnRetry" />
            <Button Style="{StaticResource Quiet}" Margin="12,0,0,0" Content="Close" Click="OnClose" />
          </StackPanel>
        </StackPanel>
      </Grid>

    </Grid>
  </Grid>
</Window>
